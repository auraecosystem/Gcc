AT_SETUP([Calculator arithmetic])

AT_DATA([calc.y],
[[
%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *);
%}

%token NUMBER
%left '+'
%left '*'

%%

input:
    expression '\n' { printf("%d\n", $1); }
    ;

expression:
      NUMBER
    | expression '+' expression { $$ = $1 + $3; }
    | expression '*' expression { $$ = $1 * $3; }
    ;

%%

int yylex(void)
{
    int c = getchar();

    if (c >= '0' && c <= '9') {
        yylval = c - '0';
        return NUMBER;
    }

    return c;
}

void yyerror(const char *s)
{
    fprintf(stderr, "%s\n", s);
}

int main(void)
{
    return yyparse();
}
]])

AT_CHECK([bison -o calc.c calc.y], [0])
AT_CHECK([$CC $CFLAGS -o calc calc.c], [0])
AT_CHECK([printf '2+3\n' | ./calc], [0], [5
])
AT_CHECK([printf '2+3*4\n' | ./calc], [0], [14
])

AT_CLEANUP
