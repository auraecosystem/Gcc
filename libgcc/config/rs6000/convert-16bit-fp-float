#
# The PowerPC 16-bit floating point support is considering requiring
# 16-bit floating point arguments to the 32/64-bit scalar format in
# registers and similarly returning the 16-bit floating point return to
# a 32/64-bit scalar value.  However, this presents a problem in that
# if a machine doesn't have instructions to do a conversion in
# hardware, you can't call the soft-fp conversion function using the
# native calling sequence.
#
# This perl script converts a float<int><fp>.c. or floatun<int><fp>.c
# file to do the conversion to BFtype (Google brain 16-bit float) or
# HFtype (IEEE 754 _Float16).  It produces 2 functions, one that has
# the normal name and takes the normal arguments, and the other that
# adds a _gpr suffix and changes the 16-bit floating point to unsigned
# short.
#
# A typical fix* conversion file looks like:
#
# <copyright message>
#
# DFtype
# __floatdidf (DItype i)
# {
#   FP_DECL_EX;
#   FP_DECL_D (A);
#   DFtype a;
#
#   FP_INIT_ROUNDMODE;
#   FP_FROM_INT_D (A, i, DI_BITS, UDItype);
#   FP_PACK_RAW_D (a, A);
#   FP_HANDLE_EXCEPTIONS;
#
#   return a;
# }

use warnings;
use strict;
use Getopt::Std;

use vars qw($opt_t);

$opt_t = undef;

&getopts ("t:") || die "Useage $0 [-t type] <input >output\n";

die "$0: No -t option.\n"			if (! defined ($opt_t));

my ($input_lc,
    $output_lc,
    $uns_lc,
    $uns_uc_U);

if ($opt_t =~ /float(|un)([sdt])i([bh])f/) {
	if (defined ($1) && $1 ne "") {
		($uns_lc, $uns_uc_U) = ("un", "U");

	} else {
		($uns_lc, $uns_uc_U) = ("", "");
	}

	($input_lc, $output_lc) = ($2, $3);

} else {
	die "$0: Invalid -t ${opt_t}\n";
}

my $input_uc	= uc ($input_lc);
my $input_uc_I	= "${input_uc}I";
my $input_lc_i	= "${input_lc}i";
my $input_type	= "${uns_uc_U}${input_uc}Itype";

my $output_uc	= uc ($output_lc);
my $output_uc_F	= "${output_uc}F";
my $output_lc_f	= "${output_lc}f";
my $output_type	= "${output_uc}Ftype";

my %include_file = ("bf" => "#include \"brain.h\"",
		    "hf" => "#include \"half.h\"",
		    "sf" => "#include \"single.h\"",
		    "df" => "#include \"double.h\"");

# Scan the input and put out the copyright message

my $line;
my $input = $ARGV[0];

while ($line = <>) {
	chomp $line;

	last			if ($line =~ /^[#](include|define)/);
	print $line, "\n";
}

if ($input) {
	print "/* Automatically converted from $input.  */\n";
	print "\n";
}

# Change the include file from the floating point type to either half.h
# or brain.h.

die "$0: No include files\n"	if (! defined ($line));

do {
	if ($line =~ /^[#]include [\"](single|double|extended|half|quad|brain)[.]h[\"]$/) {
		print $include_file{$output_lc_f}, "\n";

	} else {
		print $line, "\n";
	}

	$line = <>;

} while (defined ($line) && $line =~ /^[#](include|define)/);

# Scoop up the rest of the file, convert the function to
# return a HFtype or BFtype type.

die "$0: No main source\n"	if (! defined ($line));

my @func = ();
my $FP   = "BDHST";
my $fp   = lc ($FP);
my $INT  = "QHSDT";
my $int  = lc ($INT);

do {
	chomp $line;

	# Function return
	if ($line =~ /^[${FP}]Ftype$/) {
		$line = $output_type;

	# Function line
	} elsif ($line =~ /^__float/) {
		$line = "__float${uns_lc}${input_lc_i}${output_lc_f} (${input_type} i)";

	# Return variable declaration
	} elsif ($line =~ /^(\s*)[${FP}]Ftype a;/) {
		$line = "${1}${output_type} a;";

	# Int input
	} elsif ($line =~ /FROM_INT_[${INT}]/) {
		$line =~ s/FROM_INT_[${INT}]/FROM_INT_${output_uc}/;
		$line =~ s/[${INT}]I_BITS/${input_uc_I}_BITS/;
		$line =~ s/(U)?[${INT}]Itype/${input_type}/;
	}

	$line =~ s/_(DECL|RAW)_[${FP}]/_${1}_${output_uc}/;

	push (@func, $line);
	$line = <>;

} while (defined ($line));

# Print out the normal conversion function

print "\n";
print "/* ${output_type} returned in FPR registers.  */\n";

foreach $line (@func) {
	print $line, "\n";
}

# Print out the special GPR function.

print "\n";
print "/* ${output_type} returned in GPR registers.  */\n";

foreach $line (@func) {

	# Function return
	if ($line eq $output_type) {
		$line = "unsigned short";

	# Function header
	} elsif ($line =~ /^__(float|floatun)([sdt]i)([bh]f) (.*)$/) {
		$line = "__${1}${2}${3}_gpr ${4}";

	# Return value
	} elsif ($line =~ /^(\s*)return a;/) {
		print "${1}u.${output_lc_f} = a;\n";
		$line = "${1}return u.us;";
	}

	print $line, "\n";

	# Add declartion of union
	if ($line =~ /^(\s*)[${FP}]Ftype a;/) {
		print "  union ushort_${output_lc_f} u;\n";
	}

}

# Done
exit 0;
