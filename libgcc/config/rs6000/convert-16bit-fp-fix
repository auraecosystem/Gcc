#
# The PowerPC 16-bit floating point support is considering requiring
# 16-bit floating point arguments to the 32/64-bit scalar format in
# registers and similarly returning the 16-bit floating point return to
# a 32/64-bit scalar value.  However, this presents a problem in that
# if a machine doesn't have instructions to do a conversion in
# hardware, you can't call the soft-fp conversion function using the
# native calling sequence.
#
# This perl script converts a fix<fp><int>.c. or fixuns<fp><int>.c file
# to do the conversion to BFtype (Google brain 16-bit float) or HFtype
# (IEEE 754 _Float16).  It produces 2 functions, one that has the
# normal name and takes the normal arguments, and the other that adds a
# _gpr suffix and changes the 16-bit floating point to unsigned short.
#
# A typical fix* conversion file looks like:
#
# <copyright message>
#
# #include "soft-fp.h"
# #include "single.h"
#
# DItype
# __fixsfdi (SFtype a)
# {
#   FP_DECL_EX;
#   FP_DECL_S (A);
#   UDItype r;
#
#   FP_INIT_EXCEPTIONS;
#   FP_UNPACK_RAW_S (A, a);
#   FP_TO_INT_S (r, A, DI_BITS, 1);
#   FP_HANDLE_EXCEPTIONS;
#
#   return r;
# }

use warnings;
use strict;
use Getopt::Std;

use vars qw($opt_t);

$opt_t = undef;

&getopts ("t:") || die "Useage $0 [-t type] <input >output\n";

die "$0: No -t option.\n"			if (! defined ($opt_t));

my ($input_lc,
    $output_lc,
    $uns_lc,
    $uns_uc_U,
    $uns_sign);

if ($opt_t =~ /fix(|uns)([bh])f([sdt])i/) {
	if (defined ($1) && $1 ne "") {
		($uns_lc, $uns_uc_U, $uns_sign) = ("uns", "U", 0);

	} else {
		($uns_lc, $uns_uc_U, $uns_sign) = ("", "", 1);
	}

	($input_lc, $output_lc) = ($2, $3);

} else {
	die "$0: Invalid -t ${opt_t}\n";
}

my $input_uc	= uc ($input_lc);
my $input_uc_F	= "${input_uc}F";
my $input_lc_f	= "${input_lc}f";
my $input_type	= "${input_uc}Ftype";

my $output_uc	= uc ($output_lc);
my $output_uc_I	= "${output_uc}I";
my $output_lc_i	= "${output_lc}i";
my $output_type	= "${uns_uc_U}${output_uc}Itype";

my %include_file = ("bf" => "#include \"brain.h\"",
		    "hf" => "#include \"half.h\"",
		    "sf" => "#include \"single.h\"",
		    "df" => "#include \"double.h\"");

# Scan the input and put out the copyright message

my $line;
my $input = $ARGV[0];

while ($line = <>) {
	chomp $line;

	last			if ($line =~ /^[#](include|define)/);
	print $line, "\n";
}

if ($input) {
	print "/* Automatically converted from $input.  */\n";
	print "\n";
}

# Change the include file from the floating point type to either half.h
# or brain.h.

die "$0: No include files\n"	if (! defined ($line));

do {
	if ($line =~ /^[#]include [\"](single|double|extended|half|quad|brain)[.]h[\"]$/) {
		print $include_file{$input_lc_f}, "\n";

	} else {
		print $line, "\n";
	}

	$line = <>;

} while (defined ($line) && $line =~ /^[#](include|define)/);

# Scoop up the rest of the file, convert the input and function to
# operate on HFtype or BFtype.

die "$0: No main source\n"	if (! defined ($line));

my @func = ();
my $FP   = "BDHST";
my $INT  = "QHSDT";

do {
	chomp $line;

	# Function line
	if ($line =~ /^__fix/) {
		$line = "__fix${uns_lc}${input_lc_f}${output_lc_i} (${input_type} a)";

	# Return type for function
	} elsif ($line =~ /^(U)?[${INT}]Itype$/) {
		$line = $output_type;

	# Return value
	} elsif ($line =~ /^(\s*)(U)?[${INT}]Itype r;/) {
		$line = "${1}${output_type} r;";

	# Conversion to int
	} elsif ($line =~ /^(\s*)FP_TO_INT_[${FP}] [(]r, A, [${INT}]I_BITS, [01][)];/) {
		$line = "${1}FP_TO_INT_${input_uc} (r, A, ${output_uc_I}_BITS, ${uns_sign});";

	} else {
		$line =~ s/_(DECL|RAW|INT)_[${FP}]/_${1}_${input_uc}/;
	}

	push (@func, $line);
	$line = <>;

} while (defined ($line));

# Print out the normal conversion function

print "\n";
print "/* ${input_type} passed in FPR registers.  */\n";

foreach $line (@func) {
	print $line, "\n";
}

# Print out the special GPR function.

print "\n";
print "/* ${input_type} passed in GPR registers.  */\n";

foreach $line (@func) {

	# Function header
	if ($line =~ /^__(fix|fixuns)([bh]f)([sdt]i)/) {
		$line = "__${1}${2}${3}_gpr (unsigned short us)";
	}

	print $line, "\n";

	# Add conversion from unsigned short
	if ($line =~ /^(\s*)U?[${INT}]Itype r;/) {
		print "${1}${input_type} a;\n";
		print "${1}union ushort_${input_lc_f} u;\n";
		print "\n";
		print "${1}u.us = us;\n";
		print "${1}a = u.${input_lc_f};\n";
	}
}

# Done
exit 0;
