#
# The PowerPC 16-bit floating point support is considering requiring
# 16-bit floating point arguments to the 32/64-bit scalar format in
# registers and similarly returning the 16-bit floating point return to
# a 32/64-bit scalar value.  However, this presents a problem in that
# if a machine doesn't have instructions to do a conversion in
# hardware, you can't call the soft-fp conversion function using the
# native calling sequence.
#
# This perl script converts a trunc<fp1><fp2>.c to do the conversion
# from BFtype (Google brain 16-bit float) or HFtype (IEEE 754 _Float16).
# It produces 2 functions, one that has the normal name and takes the
# normal arguments, and the other that adds a _gpr suffix and changes
# the 16-bit floating point to unsigned short.
#
# A typical trunc* conversion file looks like:
#
# <copyright message>
#
# #include "soft-fp.h"
# #include "half.h"
# #include "double.h"
#
# HFtype
# __truncdfhf2 (DFtype a)
# {
#   FP_DECL_EX;
#   FP_DECL_D (A);
#   FP_DECL_H (R);
#   HFtype r;
#
#   FP_INIT_ROUNDMODE;
#   FP_UNPACK_SEMIRAW_D (A, a);
# #if _FP_W_TYPE_SIZE < _FP_FRACBITS_D
#   FP_TRUNC (H, D, 1, 2, R, A);
# #else
#   FP_TRUNC (H, D, 1, 1, R, A);
# #endif
#   FP_PACK_SEMIRAW_H (r, R);
#   FP_HANDLE_EXCEPTIONS;
#
#   return r;
# }

use warnings;
use strict;
use Getopt::Std;

use vars qw($opt_t);

$opt_t = undef;

&getopts ("t:") || die "Useage $0 [-t type] <input >output\n";

die "$0: No -t option.\n"			if (! defined ($opt_t));

my ($input_lc, $output_lc);

if ($opt_t =~ /trunc([sd])f([bh])f2/) {
	($input_lc, $output_lc) = ($1, $2);

} else {
	die "$0: Invalid -t ${opt_t}\n";
}

my $input_uc	= uc ($input_lc);
my $input_uc_F	= "${input_uc}F";
my $input_lc_f	= "${input_lc}f";
my $input_type	= "${input_uc}Ftype";

my $output_uc	= uc ($output_lc);
my $output_uc_F	= "${output_uc}F";
my $output_lc_f	= "${output_lc}f";
my $output_type	= "${output_uc}Ftype";

my %include_file = ("bf" => "#include \"brain.h\"",
		    "hf" => "#include \"half.h\"",
		    "sf" => "#include \"single.h\"",
		    "df" => "#include \"double.h\"");

# Scan the input and put out the copyright message

my $line;
my $input = $ARGV[0];

while ($line = <>) {
	chomp $line;

	last			if ($line =~ /^[#](include|define)/);
	print $line, "\n";
}

if ($input) {
	print "/* Automatically converted from $input.  */\n";
	print "\n";
}

# Change the include file from the floating point type to either half.h
# or brain.h.

die "$0: No include files\n"	if (! defined ($line));

my $include_found = 0;

do {
	if ($line =~ /^#include ["](brain|half|single|double|quad)[.]h["]$/) {
		if (!$include_found) {
			print $include_file{$input_lc_f}, "\n";
			print $include_file{$output_lc_f}, "\n";
			$include_found = 1;
		}

	} else {
		print $line, "\n";
	}

	$line = <>;

} while (defined ($line) && $line =~ /^(\s*$|[#](include|define))/);

# Scoop up the rest of the file, convert the input and function to
# operate on HFtype or BFtype.

die "$0: No main source\n"	if (! defined ($line));

my @func = ();
my $FP   = "BDHSTQ";

do {
	chomp $line;

	# Return type
	if ($line =~ /^[${FP}]Ftype$/) {
		$line = $output_type;

	# Function line
	} elsif ($line =~ /^__trunc/) {
		$line = "__trunc${input_lc_f}${output_lc_f}2 (${input_type} a)";

	# Declaration line of the input type
	} elsif ($line =~ /^(\s*FP_DECL_)[${FP}] [(]A[)];/) {
		$line = "${1}${input_uc} (A);";

	# Declaration line of the output type
	} elsif ($line =~ /^(\s*FP_DECL_)[${FP}] [(]R[)];/) {
		$line = "${1}${output_uc} (R);";

	# Declaration of the actual result
	} elsif ($line =~ /^(\s*)[${FP}]Ftype r;/) {
		$line = "${1}${output_type} r;";

	} else {
		# Unpack input type
		$line =~ s/FP_UNPACK_(SEMI)?RAW_[${FP}]/FP_UNPACK_${1}RAW_${input_uc}/;

		# Pack output type
		$line =~ s/FP_PACK_(SEMI)?RAW_[${FP}]/FP_PACK_${1}RAW_${output_uc}/;

		# Trunc line
		$line =~ s/FP_TRUNC [(][${FP}], [${FP}],/FP_TRUNC (${output_uc}, ${input_uc},/;
	}

	push (@func, $line);
	$line = <>;

} while (defined ($line));

# Print out the normal conversion function

print "/* ${output_type} returned in FPR registers.  */\n";

foreach $line (@func) {
	print $line, "\n";
}

# Print out the conversion function that uses GPRs

print "\n";
print "/* ${output_type} returned in GPR registers.  */\n";

foreach $line (@func) {
	if ($line =~ /^[${FP}]Ftype$/) {
		$line = "unsigned short";

	} elsif ($line =~ /^__trunc/) {
		$line = "__trunc${input_lc_f}${output_lc_f}2_gpr (${input_type} a)";

	} elsif ($line =~ /^(\s*)return r;/) {
		print "${1}u.${output_lc_f} = r;\n";
		$line = "${1}return u.us;";
	}

	print $line, "\n";

	if ($line =~ /^(\s*)[${FP}]Ftype r;/) {
		print "${1}union ushort_${output_lc_f} u;\n";
	}
}

# Done
exit 0;
