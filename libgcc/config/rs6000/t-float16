# _Float16 library support, source files in soft-ftp
fp16_funcs_1	= eqhf2 \
		  floatbitinthf

fp16_src_1	= $(addprefix $(srcdir)/soft-fp/,$(addsuffix .c,$(fp16_funcs_1)))
fp16_obj_1	= $(addsuffix $(objext),$(fp16_funcs_1))

# _Float16 library support, source files in config/rs6000
fp16_funcs_2	= extendhf-sfdf2 truncsfdf-hf2 \
		  ppc-fixhfsi  ppc-fixhfdi ppc-fixhfti \
		  ppc-fixunshfsi ppc-fixunshfdi ppc-fixunshfti \
		  ppc-floatsihf ppc-floatdihf ppc-floattihf \
		  ppc-floatunsihf ppc-floatundihf ppc-floatuntihf

fp16_src_2	= $(addprefix $(srcdir)/config/rs6000/,$(addsuffix .c,$(fp16_funcs_2)))
fp16_obj_2	= $(addsuffix $(objext),$(fp16_funcs_2))

# _Float16 combined library support
fp16_funcs	= $(fp16_funcs_1) $(fp16_funcs_2)
fp16_src	= $(fp16_src_1) $(fp16_src_2)
fp16_obj	= $(fp16_obj_1) $(fp16_obj_2)

FP16_CFLAGS	= -mfloat16 -Wno-psabi \
		  -I$(srcdir)/soft-fp \
		  -I$(srcdir)/config/rs6000

$(fp16_obj)	: INTERNAL_CFLAGS += $(FP16_CFLAGS)

# __bf16 library support, source files in soft-ftp
bfp16_funcs_1	= floatbitintbf

bfp16_src_1	= $(addprefix $(srcdir)/soft-fp/,$(addsuffix .c,$(bfp16_funcs_1)))
bfp16_obj_1	= $(addsuffix $(objext),$(bfp16_funcs_1))

# __bf16 library support, source files in config/rs6000
bfp16_funcs_2	= extendbf-sfdf2 truncsfdf-bf2 \
		  ppc-floatsibf ppc-floatdibf ppc-floattibf \
		  ppc-floatunsibf ppc-floatundibf ppc-floatuntibf \
		  ppc-fixbfsi  ppc-fixbfdi ppc-fixbfti \
		  ppc-fixunsbfsi  ppc-fixunsbfdi ppc-fixunsbfti

bfp16_src_2	= $(addprefix $(srcdir)/config/rs6000/,$(addsuffix .c,$(bfp16_funcs_2)))
bfp16_obj_2	= $(addsuffix $(objext),$(bfp16_funcs_2))

# __bf16 combined library support
bfp16_funcs	= $(bfp16_funcs_1) $(bfp16_funcs_2)
bfp16_src	= $(bfp16_src_1) $(bfp16_src_2)
bfp16_obj	= $(bfp16_obj_1) $(bfp16_obj_2)

$(bfp16_obj)	: INTERNAL_CFLAGS += $(FP16_CFLAGS)

# Conversion between __bf16 and _Float16
both_fp16_funcs	 = ppc-truncbfhf2 ppc-trunchfbf2
both_fp16_src	 = $(addprefix $(srcdir)/config/rs6000/,$(addsuffix .c,$(both_fp16_funcs)))
both_fp16_obj	 = $(addsuffix $(objext),$(both_fp16_funcs))

$(both_fp16_obj) : INTERNAL_CFLAGS += $(FP16_CFLAGS)

# For now, only put it in the static library
# LIB2ADD	+= $(fp16_src) $(bfp16_src) $(both_fp16_src)

LIB2ADD_ST	+= $(fp16_src) $(bfp16_src) $(both_fp16_src)

.PHONY: test-float16 clean-float16

test-float16:
	@echo "fp16_src:"; \
	for x in $(fp16_src); do echo "    $$x"; done; \
	echo; \
	echo "bfp16_src:"; \
	for x in $(bfp16_src); do echo "    $$x"; done; \
	echo; \
	echo "both_fp16_src:"; \
	for x in $(both_fp16_src); do echo "    $$x"; done; \
	echo; \
	echo "fp16_obj:"; \
	for x in $(fp16_obj); do echo "    $$x"; done; \
	echo; \
	echo "bfp16_obj:"; \
	for x in $(bfp16_obj); do echo "    $$x"; done; \
	echo; \
	echo "both_fp16_obj:"; \
	for x in $(bfp16_obj); do echo "    $$x"; done;

clean-float16:
	@$(MULTICLEAN) multi-clean DO=clean-float16
