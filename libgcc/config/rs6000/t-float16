PERL		:= perl

# _Float16 library support, source files in soft-ftp
fp16_funcs	= extendhf-sfdf2 truncsfdf-hf2 \
		  ppc-eqhf2 ppc-floatbitinthf ppc-fixhfbitint

fp16_src	= $(addprefix $(srcdir)/config/rs6000/,$(addsuffix .c,$(fp16_funcs)))
fp16_obj	= $(addsuffix $(objext),$(fp16_funcs))

FP16_CFLAGS	= -mfloat16 -Wno-psabi \
		  -I$(srcdir)/soft-fp \
		  -I$(srcdir)/config/rs6000

$(fp16_obj)	: INTERNAL_CFLAGS += $(FP16_CFLAGS)

# __bf16 library support, source files in config/rs6000
bfp16_funcs	= extendbf-sfdf2 truncsfdf-bf2 \
		  ppc-eqbf2 ppc-floatbitintbf ppc-fixbfbitint

bfp16_src	= $(addprefix $(srcdir)/config/rs6000/,$(addsuffix .c,$(bfp16_funcs)))
bfp16_obj	= $(addsuffix $(objext),$(bfp16_funcs))

$(bfp16_obj)	: INTERNAL_CFLAGS += $(FP16_CFLAGS)

# Conversion between __bf16 and _Float16
both_fp16_funcs	 = ppc-truncbfhf2 ppc-trunchfbf2
both_fp16_src	 = $(addprefix $(srcdir)/config/rs6000/,$(addsuffix .c,$(both_fp16_funcs)))
both_fp16_obj	 = $(addsuffix $(objext),$(both_fp16_funcs))

$(both_fp16_obj) : INTERNAL_CFLAGS += $(FP16_CFLAGS)

# Convert functions in soft-fp to powerpc, building 2 versions, one
# with normal __bf16/_Float16 arguments, and the other where we
# pass/return 16-bit floating point in gprs.

float16_prefix		= ppc-
float16_fix_orig	= $(srcdir)/soft-fp/fixsfdi.c
float16_fixuns_orig	= $(srcdir)/soft-fp/fixsfdi.c
float16_float_orig	= $(srcdir)/soft-fp/floatdisf.c
float16_floatun_orig	= $(srcdir)/soft-fp/floatundisf.c

float16_fix_script	= $(srcdir)/config/rs6000/convert-16bit-fp-fix
float16_float_script	= $(srcdir)/config/rs6000/convert-16bit-fp-float

# Convert fix* functions for _Float16
fp16x_fix_funcs		= fixhfti fixhfdi fixhfsi
fp16x_fix_src		= $(addprefix $(float16_prefix),$(addsuffix .c,$(fp16x_fix_funcs)))
fp16x_fix_obj		= $(addprefix $(float16_prefix),$(addsuffix $(objext),$(fp16x_fix_funcs)))

fp16x_fix_dep		= $(float16_fix_orig) \
			  $(float16_fix_script) \
			  $(srcdir)/config/rs6000/t-float16

fp16x_fixuns_funcs	= fixunshfti fixunshfdi fixunshfsi
fp16x_fixuns_src	= $(addprefix $(float16_prefix),$(addsuffix .c,$(fp16x_fixuns_funcs)))
fp16x_fixuns_obj	= $(addprefix $(float16_prefix),$(addsuffix $(objext),$(fp16x_fixuns_funcs)))

fp16x_fixuns_dep	= $(float16_fixuns_orig) \
			  $(float16_fix_script) \
			  $(srcdir)/config/rs6000/t-float16

fp16x_float_funcs	= floattihf floatdihf floatsihf
fp16x_float_src		= $(addprefloat $(float16_prefloat),$(addsuffloat .c,$(fp16x_float_funcs)))
fp16x_float_obj		= $(addprefloat $(float16_prefloat),$(addsuffloat $(objext),$(fp16x_float_funcs)))

fp16x_float_depi	= $(float16_float_orig) \
			  $(float16_float_script) \
			  $(srcdir)/config/rs6000/t-float16

fp16x_floatun_funcs	= floatuntihf floatundihf floatunsihf
fp16x_floatun_src	= $(addprefloat $(float16_prefloat),$(addsuffloat .c,$(fp16x_floatun_funcs)))
fp16x_floatun_obj	= $(addprefloat $(float16_prefloat),$(addsuffloat $(objext),$(fp16x_floatun_funcs)))

fp16x_floatun_dep	= $(float16_floatun_orig) \
			  $(float16_float_script) \
			  $(srcdir)/config/rs6000/t-float16

fp16x_all_funcs		= $(fp16x_fix_funcs) $(fp16x_fixuns_funcs) \
			  $(fp16x_float_funcs) $(fp16x_floatun_funcs)

fp16x_all_src		= $(fp16x_fix_src) $(fp16x_fixuns_src) \
			  $(fp16x_float_src) $(fp16x_floatun_src)

fp16x_all_obj		= $(fp16x_fix_obj) $(fp16x_fixuns_obj) \
			  $(fp16x_float_obj) $(fp16x_floatun_obj)

$(fp16x_fix_src) : $(fp16x_fix_dep)
	$(PERL) $(float16_fix_script) -h $(float16_fix_orig) > $@

$(fp16x_fixuns_src) : $(fp16x_fixuns_dep)
	$(PERL) $(float16_fix_script) -h $(float16_fixuns_orig) > $@

$(fp16x_float_src) : $(fp16x_float_dep)
	$(PERL) $(float16_float_script) -h $(float16_float_orig) > $@

$(fp16x_floatun_src) : $(fp16x_floatun_dep)
	$(PERL) $(float16_float_script) -h $(float16_floatun_orig) > $@

$(fp16x_all_obj)	: INTERNAL_CFLAGS += $(FP16_CFLAGS)

# Convert fix* functions for __bf12
bfp16x_fix_funcs	= fixbfti fixbfdi fixbfsi
bfp16x_fix_src		= $(addprefix $(float16_prefix),$(addsuffix .c,$(bfp16x_fix_funcs)))
bfp16x_fix_obj		= $(addprefix $(float16_prefix),$(addsuffix $(objext),$(bfp16x_fix_funcs)))

bfp16x_fix_dep		= $(float16_fix_orig) \
			  $(float16_fix_script) \
			  $(srcdir)/config/rs6000/t-float16

bfp16x_fixuns_funcs	= fixunsbfti fixunsbfdi fixunsbfsi
bfp16x_fixuns_src	= $(addprefix $(float16_prefix),$(addsuffix .c,$(bfp16x_fixuns_funcs)))
bfp16x_fixuns_obj	= $(addprefix $(float16_prefix),$(addsuffix $(objext),$(bfp16x_fixuns_funcs)))

bfp16x_fixuns_dep	= $(float16_fixuns_orig) \
			  $(float16_fix_script) \
			  $(srcdir)/config/rs6000/t-float16

bfp16x_float_funcs	= floattibf floatdibf floatsibf
bfp16x_float_src	= $(addprefloat $(float16_prefloat),$(addsuffloat .c,$(bfp16x_float_funcs)))
bfp16x_float_obj	= $(addprefloat $(float16_prefloat),$(addsuffloat $(objext),$(bfp16x_float_funcs)))

bfp16x_float_depi	= $(float16_float_orig) \
			  $(float16_float_script) \
			  $(srcdir)/config/rs6000/t-float16

bfp16x_floatun_funcs	= floatuntibf floatundibf floatunsibf
bfp16x_floatun_src	= $(addprefloat $(float16_prefloat),$(addsuffloat .c,$(bfp16x_floatun_funcs)))
bfp16x_floatun_obj	= $(addprefloat $(float16_prefloat),$(addsuffloat $(objext),$(bfp16x_floatun_funcs)))

bfp16x_floatun_dep	= $(float16_floatun_orig) \
			  $(float16_float_script) \
			  $(srcdir)/config/rs6000/t-float16

bfp16x_all_funcs	= $(bfp16x_fix_funcs) $(bfp16x_fixuns_funcs) \
			  $(bfp16x_float_funcs) $(bfp16x_floatun_funcs)

bfp16x_all_src		= $(bfp16x_fix_src) $(bfp16x_fixuns_src) \
			  $(bfp16x_float_src) $(bfp16x_floatun_src)

bfp16x_all_obj		= $(bfp16x_fix_obj) $(bfp16x_fixuns_obj) \
			  $(bfp16x_float_obj) $(bfp16x_floatun_obj)

$(bfp16x_fix_src) : $(bfp16x_fix_dep)
	$(PERL) $(float16_fix_script) -b $(float16_fix_orig) > $@

$(bfp16x_fixuns_src) : $(bfp16x_fixuns_dep)
	$(PERL) $(float16_fix_script) -b $(float16_fixuns_orig) > $@

$(bfp16x_float_src) : $(bfp16x_float_dep)
	$(PERL) $(float16_float_script) -b $(float16_float_orig) > $@

$(bfp16x_floatun_src) : $(bfp16x_floatun_dep)
	$(PERL) $(float16_float_script) -b $(float16_floatun_orig) > $@

$(bfp16x_all_obj)	: INTERNAL_CFLAGS += $(FP16_CFLAGS)

# For now, only put it in the static library
# LIB2ADD	+= $(fp16_src) $(bfp16_src) $(both_fp16_src)

LIB2ADD_ST	+= $(fp16_src) $(bfp16_src) $(both_fp16_src) \
		   $(fp16x_all_src) $(bfp16x_all_src)

.PHONY: test-float16 clean-float16 ppc-srcfiles

test-float16:
	@echo "fp16_src:"; \
	for x in $(fp16_src); do echo "    $$x"; done; \
	echo; \
	echo "bfp16_src:"; \
	for x in $(bfp16_src); do echo "    $$x"; done; \
	echo; \
	echo "both_fp16_src:"; \
	for x in $(both_fp16_src); do echo "    $$x"; done; \
	echo; \
	echo "fp16_obj:"; \
	for x in $(fp16_obj); do echo "    $$x"; done; \
	echo; \
	echo "bfp16_obj:"; \
	for x in $(bfp16_obj); do echo "    $$x"; done; \
	echo; \
	echo "both_fp16_obj:"; \
	for x in $(bfp16_obj); do echo "    $$x"; done; \
	echo; \
	echo "fp16x_all_funcs:"; \
	for x in $(fp16x_all_funcs); do echo "    $$x"; done; \
	echo; \
	echo "fp16x_all_src:"; \
	for x in $(fp16x_all_src); do echo "    $$x"; done; \
	echo; \
	echo "fp16x_all_obj:"; \
	for x in $(fp16x_all_obj); do echo "    $$x"; done; \
	echo; \
	echo "bfp16x_all_funcs:"; \
	for x in $(bfp16x_all_funcs); do echo "    $$x"; done; \
	echo; \
	echo "bfp16x_all_src:"; \
	for x in $(bfp16x_all_src); do echo "    $$x"; done; \
	echo; \
	echo "bfp16x_all_obj:"; \
	for x in $(fp16x_all_obj); do echo "    $$x"; done; \
	echo; \
	echo "float16_prefix       = $(float16_prefix)"; \
	echo "float16_fix_orig     = $(float16_fix_orig)"; \
	echo "float16_fixuns_orig  = $(float16_fixuns_orig)"; \
	echo "float16_fix_script   = $(float16_fix_script)"; \
	echo "float16_float_orig   = $(float16_float_orig)"; \
	echo "float16_floatun_orig = $(float16_floatun_orig)"; \
	echo "float16_float_script = $(float16_float_script)"; \
	echo

clean-float16:
	@$(MULTICLEAN) multi-clean DO=clean-float16
	rm -f $(fp16x_all_src) $(bfp16x_all_src) ppc-srcfiles

ppc-srcfiles: $(fp16x_all_src) $(bfp16x_all_src)
	@touch ppc-srcfiles
